{
  "slug": "edtech",
  "name": "EdTech Enrollments Pack",
  "version": "1.0.0",
  "description": "Industry context for education/e-learning enrollment data — students, courses, and enrollments.",
  "vocabulary": [
    { "term": "enrollment", "definition": "A student's registration in a course" },
    { "term": "student", "definition": "A learner enrolled in one or more courses" },
    { "term": "course", "definition": "A paid or free learning offering" }
  ],
  "canonical_roles": {
    "revenue_amount": "the price of a course associated with an enrollment",
    "transaction_status": "the enrollment lifecycle state (active / completed / dropped)",
    "transaction_date": "the date of enrollment",
    "student_ref": "the student identifier",
    "course_ref": "the course identifier",
    "score": "the student's performance score in a course"
  },
  "table_aliases": {
    "fact": "the primary enrollments table"
  },
  "value_set_hints": {
    "completed_values": ["completed", "active", "passed"],
    "cancelled_values": ["dropped", "cancelled", "withdrawn"]
  },
  "guardrails": {
    "denied_role_categories": ["free_text", "email", "phone"],
    "require_read_only": true,
    "max_query_rows": 200,
    "query_timeout_seconds": 10,
    "notes": [
      "Never expose student email, phone, or full name in aggregate outputs",
      "All data access must be read-only"
    ]
  },
  "signature": {
    "entity_name_hints": ["enrollment", "student", "course", "class", "cohort", "curriculum"],
    "column_name_hints": [
      "student_id", "course_id", "enrolled_on", "grade_level", "subject", "score", "enrollment_id"
    ],
    "required_role_categories": ["date", "identifier"],
    "table_count_range": [1, 10]
  },
  "skill_templates": [
    { "id": "enrollment-analyst", "template_path": "skills/enrollment-analyst.md.j2", "requires_roles": [], "description": "General enrollment analytics" }
  ],
  "agent_templates": [
    { "id": "edtech-analyst", "template_path": "agents/edtech-analyst.md.j2", "requires_roles": [], "description": "Deep-dive enrollment analysis agent" }
  ],
  "recipe_templates": [
    { "id": "monthly-report", "template_path": "recipes/monthly-report.md.j2", "requires_roles": ["transaction_date"], "description": "Monthly enrollment report recipe" }
  ]
}
