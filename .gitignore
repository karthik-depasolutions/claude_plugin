# Secrets
.env
.env.*
!.env.example
*.key
*.pem
# SSH private keys are often extensionless (id_rsa, id_ed25519, id_<name>) -
# never rely on an extension check alone for these.
id_*
!id_*.pub

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Node / web
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo

# Generated run output (never versioned — this is the product's output, not source)
/generated/
/apps/api/*.db
/apps/api/uploads/

# Marketplace working copies pulled during publish tests
/marketplace/.cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
