{
  "$defs": {
    "CheckStatus": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "skipped"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "ValidationCheckResult": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "title": "Check",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "skipped_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped Reason"
        }
      },
      "required": [
        "check",
        "status"
      ],
      "title": "ValidationCheckResult",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "severity",
        "location",
        "message"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plugin_name": {
      "title": "Plugin Name",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ValidationCheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "overall": {
      "$ref": "#/$defs/CheckStatus"
    }
  },
  "required": [
    "plugin_name",
    "generated_at",
    "checks",
    "overall"
  ],
  "title": "ValidationReport",
  "type": "object"
}