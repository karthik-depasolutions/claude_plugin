# --- LLM provider -----------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
FORGE_LLM_PROVIDER=gemini
FORGE_LLM_PROFILING_MODEL=gemini-2.5-flash
FORGE_LLM_GENERATION_MODEL=gemini-2.5-flash
FORGE_LLM_CRITIQUE_MODEL=gemini-2.5-flash

# Set to record/replay Gemini calls as fixtures instead of hitting the live API.
# off (default) | record | replay
FORGE_LLM_CASSETTE_MODE=off
FORGE_LLM_CASSETTE_DIR=fixtures/cassettes

# --- API service --------------------------------------------------------------
# SQLite is the default for local dev (zero setup). Point at Postgres in staging/prod:
#   postgresql+psycopg://forge:forge@localhost:5432/forge
FORGE_DATABASE_URL=sqlite+aiosqlite:///./generated/forge.db
FORGE_RUNS_DIR=./generated/runs
FORGE_API_CORS_ORIGINS=http://localhost:5173

# --- Publishing ----------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ORG=your-org
FORGE_MARKETPLACE_REPO=your-org/mis-plugins

# --- Claude CLI (used by the validation harness's cli_validate check) ----------
# Leave unset to auto-discover `claude` on PATH.
CLAUDE_CLI_PATH=

# --- Client data warehouse (optional) -------------------------------------------
# When unset, POST /runs/upload behaves exactly as before: uploads are saved to
# local files under FORGE_RUNS_DIR. When FORGE_CLIENT_WAREHOUSE_URL *and*
# FORGE_CLIENT_WAREHOUSE_PUBLIC_HOST are both set, uploads are instead loaded
# into a dedicated Postgres schema and the plugin connects live to it -
# see forge_core.ingestion.warehouse and docs/client-warehouse.md.
#
# FORGE_CLIENT_WAREHOUSE_URL is the *admin* connection - it must only be
# reachable from wherever this API process runs (e.g. over an SSH tunnel to
# the staging box: `ssh -i id_e2estaging -N -L 15432:127.0.0.1:5432 root@<host>`,
# then point this at postgresql://forge_admin:<password>@127.0.0.1:15432/forge_warehouse).
FORGE_CLIENT_WAREHOUSE_URL=
# The network-reachable host/port baked into the connection string handed to
# clients - almost always different from FORGE_CLIENT_WAREHOUSE_URL's host/port.
FORGE_CLIENT_WAREHOUSE_PUBLIC_HOST=
FORGE_CLIENT_WAREHOUSE_PUBLIC_PORT=5432
FORGE_CLIENT_WAREHOUSE_DATABASE=forge_warehouse
