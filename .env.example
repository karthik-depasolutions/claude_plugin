# --- LLM provider -----------------------------------------------------------
# gemini (default) | anthropic. Per-role override:
# FORGE_LLM_{PROFILING,GENERATION,CRITIQUE}_PROVIDER.
FORGE_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here   # only if FORGE_LLM_PROVIDER=anthropic

# Per-role model. Defaults follow the provider (gemini-2.5-flash / claude-sonnet-5).
FORGE_LLM_PROFILING_MODEL=gemini-2.5-flash
FORGE_LLM_GENERATION_MODEL=gemini-2.5-flash
FORGE_LLM_CRITIQUE_MODEL=gemini-2.5-flash

# Allow a run to proceed with NO LLM (structural docs, template prose, no
# verified cookbook) instead of failing when no provider is configured.
# FORGE_LLM_DEGRADED_OK=false

# Set to record/replay LLM calls as fixtures instead of hitting the live API.
# off (default) | record | replay
FORGE_LLM_CASSETTE_MODE=off
FORGE_LLM_CASSETTE_DIR=fixtures/cassettes

# --- API service --------------------------------------------------------------
# SQLite is the default for local dev (zero setup). Point at Postgres in staging/prod:
#   postgresql+psycopg://forge:forge@localhost:5432/forge
FORGE_DATABASE_URL=sqlite+aiosqlite:///./generated/forge.db
FORGE_RUNS_DIR=./generated/runs
FORGE_API_CORS_ORIGINS=http://localhost:5173
# Public HTTPS origin Claude Desktop uses to reach hosted MCP on this API.
# Localhost will not work for Cowork (Anthropic's cloud must reach it) — use a
# tunnel for demos, e.g. `cloudflared tunnel --url http://localhost:8000` or a
# reserved ngrok domain (`ngrok http --domain=<name>.ngrok-free.dev 8420`); an
# ngrok URL here also gets the browser-warning-skip header baked into .mcp.json.
# This is the only local-vs-production switch: set the tunnel URL locally, the
# real origin in prod. Also set FORGE_SOURCE_DB_URL — on this path the API, not
# the end user, connects to Postgres.
FORGE_PUBLIC_BASE_URL=
FORGE_SOURCE_DB_URL=

# --- Publishing ----------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ORG=your-org
FORGE_MARKETPLACE_REPO=your-org/mis-plugins

# --- Claude CLI (used by the validation harness's cli_validate check) ----------
# Leave unset to auto-discover `claude` on PATH.
CLAUDE_CLI_PATH=

# --- Client data warehouse (optional) -------------------------------------------
# When unset, POST /runs/upload behaves exactly as before: uploads are saved to
# local files under FORGE_RUNS_DIR. When FORGE_CLIENT_WAREHOUSE_URL *and*
# FORGE_CLIENT_WAREHOUSE_PUBLIC_HOST are both set, uploads are instead loaded
# into a dedicated Postgres schema and the plugin connects live to it, and
# POST /runs {clone: true} can clone one schema of a customer's postgresql://
# source into the warehouse - see forge_core.ingestion.warehouse and
# docs/client-warehouse.md.
#
# FORGE_CLIENT_WAREHOUSE_URL is the *admin* connection - it must only be
# reachable from wherever this API process runs (e.g. over an SSH tunnel to
# the staging box: `ssh -i id_e2estaging -N -L 15432:127.0.0.1:5432 root@<host>`,
# then point this at postgresql://forge_admin:<password>@127.0.0.1:15432/forge_warehouse).
FORGE_CLIENT_WAREHOUSE_URL=
# The network-reachable host/port baked into the connection string handed to
# clients - almost always different from FORGE_CLIENT_WAREHOUSE_URL's host/port.
FORGE_CLIENT_WAREHOUSE_PUBLIC_HOST=
FORGE_CLIENT_WAREHOUSE_PUBLIC_PORT=5432
FORGE_CLIENT_WAREHOUSE_DATABASE=forge_warehouse

# Caps on cloning a customer's postgresql:// source into the warehouse
# (POST /runs {clone: true}). A source over either limit is rejected with
# HTTP 413 - nothing partial is stored. Defaults shown.
FORGE_CLONE_MAX_TABLES=200
FORGE_CLONE_MAX_ROWS=2000000

# --- Agent Schema mode (--agent-schema / POST /runs {agent_schema: true}) ------
# For 25-500 table databases. All optional; defaults shown. See docs/agent-schema.md.
# Tables per shard file under config/catalog/.
FORGE_CATALOG_TABLES_PER_SHARD=20
# Max ~chars of the per-chunk tables block in global synthesis.
FORGE_GLOBAL_CHUNK_CHARS=30000
# Upper bound on merged cookbook entries (each is a live dry-run).
FORGE_COOKBOOK_MAX_ENTRIES=80
# Force the FAST profiling budget (declared PK/FK only, no O(n^2) probing, no
# pattern mining, no quality analysis) even for a real-LLM run. A no-LLM run
# (POST /runs {no_llm: true} / `forge run --no-llm`) implies this already.
FORGE_AGENT_SCHEMA_FAST=0
